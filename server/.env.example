# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CLIENT_URL=http://localhost:5173

# Database (matches docker-compose.yml; host port 5433)
DATABASE_URL=postgresql://aicompliance:aicompliance@localhost:5433/aicompliance?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=aic_session

# Field encryption master key: base64-encoded 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave blank in dev (data stored as-is). In production this MUST be set, kept
# stable, and backed up, or encrypted customer data becomes unrecoverable.
DATA_ENC_KEY=

# Uploaded-document storage: Garage (self-hosted S3-compatible store).
# Leave GARAGE_S3_ENDPOINT blank in dev to fall back to local disk (uploads/).
GARAGE_S3_ENDPOINT=
GARAGE_S3_REGION=garage
GARAGE_BUCKET=
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=

# Email
# Primary transport is Resend (https://resend.com). Set RESEND_API_KEY and use a
# FROM address on a domain verified in your Resend account.
# In development, leave RESEND_API_KEY and SMTP_HOST blank: emails are printed to
# the server logs (set EMAIL_PREVIEW=true for Ethereal preview URLs instead).
RESEND_API_KEY=
EMAIL_FROM="Compliance Check <no-reply@aicompliance.local>"

# Optional SMTP fallback (used only when RESEND_API_KEY is not set).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Screenshot-feedback plugin (comma-separated recipient list)
FEEDBACK_RECIPIENTS=team@example.com

# Reminders
REMINDER_CRON=0 7 * * *
REMINDER_LEAD_DAYS=30

# Scheduled jobs
SNAPSHOT_CRON=0 1 * * *
MONTHLY_REPORT_CRON=0 8 1 * *

# Optional: Claude API for the Law Explorer "describe your AI use" feature.
# Leave blank to use the built-in keyword matcher instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
