// Germany AI Compliance platform - data model
// Design principle: CATALOG data (the law, authored once) is split from
// TENANT data (a company's usage). Frameworks, requirements, checklist
// templates, questionnaire questions and classification rules are all ROWS,
// so a new area of law is added by seeding data - no schema change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Identity & tenancy
// ----------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  legalForm String?
  address   String? // captured at registration for the AVV (Art. 28 GDPR data processing agreement)
  industry  String?
  country   String   @default("DE")
  sizeBand  String?
  selectedFunctions Json? // saved "what does your company do?" answers (Law Explorer)
  encKeyWrapped String? // per-org data key, AES-256-GCM wrapped by the master key (field encryption)
  lastMonthlyReportAt DateTime?
  // AVV Section 16.2: support access from outside the EU (Anlage 3 Nr. 5) is
  // pseudonymised regardless, but the org can refuse it outright. Default
  // "no", matching the AVV's own stated default.
  allowNonEuSupportAccess Boolean @default(false)
  // "production" (the AVV applies) or "test": an evaluation account without an
  // AVV. The tester confirms at sign-up that no real personal data may be entered
  // (testConfirmedAt/ByEmail keep the record), and uploads, invitations and
  // community posting are blocked.
  accountType          String    @default("production")
  testConfirmedAt      DateTime?
  testConfirmedByEmail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  aiSystems     AiSystem[]
  assessments   Assessment[]
  documents     Document[]
  notifications Notification[]
  auditLogs     AuditLog[]
  reminders     ReminderSchedule[]
  invitations   Invitation[]
  comments      Comment[]
  snapshots     ComplianceSnapshot[]
  threads       Thread[]
  threadPosts   ThreadPost[]
  avvAcceptances      AvvAcceptance[]
  supportAccessGrants SupportAccessGrant[]
}

model User {
  id              String    @id @default(uuid())
  organizationId  String?
  email           String    @unique
  passwordHash    String
  fullName        String
  role            String    @default("owner") // owner | admin | member | platform_admin
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  // TOTP multi-factor auth (per-account, opt-in). mfaSecret is stored encrypted
  // at rest (fieldCrypto); mfaBackupCodes holds bcrypt hashes of one-time codes.
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String?
  mfaBackupCodes  Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization      Organization?  @relation(fields: [organizationId], references: [id])
  emailTokens       EmailToken[]
  notifications     Notification[]
  assignedResponses ChecklistItemResponse[] @relation("ResponseAssignee")
  comments          Comment[]
  invitationsSent   Invitation[]   @relation("InvitedBy")
  threads           Thread[]
  threadPosts       ThreadPost[]
  threadVotes       ThreadVote[]
  threadReports     ThreadReport[]
  avvAcceptances        AvvAcceptance[]
  supportAccessGranted  SupportAccessGrant[] @relation("SupportAccessGrantedBy")
  supportAccessRevoked  SupportAccessGrant[] @relation("SupportAccessRevokedBy")

  @@index([organizationId])
}

model EmailToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  purpose   String // verify_email | reset_password
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Catalog (the law, as data)
// ----------------------------------------------------------------------------

model Framework {
  id               String   @id @default(uuid())
  key              String   @unique // eu_ai_act | gdpr | bafin_ki | dora ...
  name             String
  shortName        String?
  tier             Int      @default(2) // 1 EU | 2 German national | 3 sector
  jurisdiction     String   @default("EU") // EU | DE
  category         String   @default("ai") // ai | data_protection | financial | security | ...
  shortDescription String?
  regulator        String? // competent German authority
  reference        String? // e.g. "Regulation (EU) 2024/1689"
  lawReferenceUrl  String?
  appliesTo        String? // plain-language "who must comply"
  keySections      String? // plain-language "key sections / articles"
  whatYouMustDo    Json? // array of plain-language practical action strings
  keyDates         Json? // array of plain-language deadline/date strings
  penalties        String? // plain-language maximum penalties
  translations     Json? // { de: { name, shortDescription, appliesTo, whatYouMustDo, keyDates, penalties, regulator } }
  sourceNote       String? // citation / where the content was verified against
  lastReviewedAt   DateTime? // when the catalog content was last reviewed
  version          String   @default("1.0")
  status           String   @default("published") // draft | published | archived
  effectiveFrom    DateTime?
  icon             String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requirements      Requirement[]
  templates         ChecklistTemplate[]
  questionnaires    ClassificationQuestionnaire[]
  activationRules   FrameworkActivationRule[]
  assessments       Assessment[]
  threads           Thread[]
}

model Requirement {
  id                  String   @id @default(uuid())
  frameworkId         String
  code                String // e.g. "Art.9"
  title               String
  guidanceText        String // plain-language explanation
  lawReferenceUrl     String?
  lawReferenceLabel   String?
  severity            String   @default("recommended") // informational | recommended | mandatory
  parentRequirementId String?
  sortOrder           Int      @default(0)
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  framework Framework      @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  parent    Requirement?   @relation("RequirementChildren", fields: [parentRequirementId], references: [id])
  children  Requirement[]  @relation("RequirementChildren")
  items     TemplateItem[]

  @@unique([frameworkId, code])
  @@index([frameworkId])
}

model ChecklistTemplate {
  id                   String   @id @default(uuid())
  frameworkId          String
  key                  String
  name                 String
  description          String?
  appliesToRiskCategory String? // prohibited | high | limited | minimal | null = all
  autoActivate         Boolean  @default(true) // false = sector checklist, started manually
  version              String   @default("1.0")
  status               String   @default("published")
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  framework       Framework                 @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  items           TemplateItem[]
  activationRules FrameworkActivationRule[]
  assessments     Assessment[]

  @@unique([frameworkId, key])
  @@index([frameworkId])
}

model TemplateItem {
  id                  String   @id @default(uuid())
  checklistTemplateId String
  requirementId       String?
  title               String
  guidanceText        String?
  inputType           String   @default("longtext") // text | longtext | boolean | none
  isRequired          Boolean  @default(false)
  defaultStatus       String   @default("not_started")
  sortOrder           Int      @default(0)
  metadata            Json?
  createdAt           DateTime @default(now())

  template    ChecklistTemplate       @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)
  requirement Requirement?            @relation(fields: [requirementId], references: [id])
  responses   ChecklistItemResponse[]

  @@index([checklistTemplateId])
}

// ---- Data-driven classification rule engine ----

model ClassificationQuestionnaire {
  id          String   @id @default(uuid())
  frameworkId String
  key         String   @unique
  name        String
  description String?
  version     String   @default("1.0")
  status      String   @default("published")
  createdAt   DateTime @default(now())

  framework Framework                @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  questions ClassificationQuestion[]
  rules     ClassificationRule[]
}

model ClassificationQuestion {
  id              String   @id @default(uuid())
  questionnaireId String
  code            String
  prompt          String
  helpText        String?
  category        String?  // banned | high | transparency (for grouping)
  answerType      String   @default("boolean") // boolean | single_select | multi_select
  options         Json?
  sortOrder       Int      @default(0)

  questionnaire ClassificationQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId, code])
}

model ClassificationRule {
  id                 String   @id @default(uuid())
  questionnaireId    String
  priority           Int // lower evaluated first, first match wins
  resultRiskCategory String // prohibited | high | limited | minimal
  conditions         Json // boolean DSL: { all:[...] } | { any:[...] } | { q,op,value }
  explanation        String
  createdAt          DateTime @default(now())

  questionnaire ClassificationQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
}

model FrameworkActivationRule {
  id                  String   @id @default(uuid())
  frameworkId         String
  riskCategory        String? // null = activate regardless of category
  checklistTemplateId String
  conditions          Json?
  createdAt           DateTime @default(now())

  framework Framework         @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  template  ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// Tenant compliance data
// ----------------------------------------------------------------------------

model AiSystem {
  id                       String   @id @default(uuid())
  organizationId           String
  name                     String
  description              String?
  purpose                  String?
  vendor                   String? // in_house | third_party
  lifecycleStage           String   @default("planning") // planning | deployed | retired
  riskCategory             String? // prohibited | high | limited | minimal
  classificationQuestionnaireKey String?
  classificationAnswers    Json?
  classificationExplanation String?
  classifiedAt             DateTime?
  dataProfile              Json? // GDPR/DPA data-protection profile answers
  createdById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessments  Assessment[]
  documents    Document[]

  @@index([organizationId])
}

model Assessment {
  id                  String    @id @default(uuid())
  organizationId      String
  aiSystemId          String?
  frameworkId         String
  checklistTemplateId String
  templateVersion     String    @default("1.0")
  title               String
  status              String    @default("not_started") // not_started | in_progress | completed | needs_review
  progressPct         Int       @default(0)
  lastReviewedAt      DateTime?
  nextReviewDueAt     DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiSystem     AiSystem?               @relation(fields: [aiSystemId], references: [id], onDelete: SetNull)
  framework    Framework               @relation(fields: [frameworkId], references: [id])
  template     ChecklistTemplate       @relation(fields: [checklistTemplateId], references: [id])
  responses    ChecklistItemResponse[]
  documents    Document[]
  reminder     ReminderSchedule?
  comments     Comment[]

  @@index([organizationId])
  @@index([aiSystemId])
}

model ChecklistItemResponse {
  id             String   @id @default(uuid())
  assessmentId   String
  templateItemId String
  status         String   @default("not_started") // not_started | in_progress | done | not_applicable
  responseText   String? // the documentation / risk-assessment writing
  assigneeId     String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  templateItem TemplateItem @relation(fields: [templateItemId], references: [id])
  assignee     User?        @relation("ResponseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  documents    Document[]
  comments     Comment[]

  @@unique([assessmentId, templateItemId])
  @@index([assessmentId])
}

model Document {
  id                      String   @id @default(uuid())
  organizationId          String
  assessmentId            String?
  checklistItemResponseId String?
  aiSystemId              String?
  fileName                String
  mimeType                String?
  sizeBytes               Int?
  storageKey              String
  // File bytes on disk are AES-256-GCM encrypted with the org data key.
  // Legacy rows written before that are stored plain and read back as-is.
  encrypted               Boolean  @default(false)
  uploadedById            String?
  createdAt               DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment   Assessment?            @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  itemResponse ChecklistItemResponse? @relation(fields: [checklistItemResponseId], references: [id], onDelete: SetNull)
  aiSystem     AiSystem?              @relation(fields: [aiSystemId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// ----------------------------------------------------------------------------
// Engagement & audit
// ----------------------------------------------------------------------------

model ReminderSchedule {
  id             String    @id @default(uuid())
  organizationId String
  assessmentId   String    @unique
  cadence        String    @default("annual") // annual | semiannual | quarterly | custom
  intervalDays   Int       @default(365)
  nextRunAt      DateTime
  leadTimeDays   Int       @default(30)
  lastFiredAt    DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
}

model Notification {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  type           String    @default("system") // review_due | review_overdue | system
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  emailSentAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String?
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([entityId])
}

// One row per Art. 28 GDPR data processing agreement (AVV) acceptance.
// Append-only: a re-acceptance of a newer version creates a new row and sets
// supersededAt on the previous one, rather than overwriting it, so an older
// accepted version stays fully reconstructable (the AVV itself promises this
// under Section 18(a), "Fruehere Fassungen bleiben abrufbar"). The document
// body itself is a static, versioned PDF (server/legal/avv-v<version>.pdf,
// see reportService's AVV_VERSIONS map), not regenerated per organisation:
// only the identity of who accepted it, on behalf of which company, is
// per-organisation data.
model AvvAcceptance {
  id               String    @id @default(uuid())
  organizationId   String
  version          String // e.g. "1.0", matches a key in AVV_VERSIONS
  acceptedByUserId String
  acceptedByName   String
  acceptedByRole   String // role at the moment of acceptance (always "owner" today, registration is the only path)
  acceptedByEmail  String
  companyName      String
  companyLegalForm String?
  companyAddress   String?
  ip               String?
  userAgent        String?
  acceptedAt       DateTime  @default(now())
  supersededAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acceptedBy   User         @relation(fields: [acceptedByUserId], references: [id])

  @@index([organizationId])
}

// The authorisation record the AVV requires before RIT support staff may
// access an organisation's data for a named case (Anlage 2, "Support-
// Zugriff"): who approved it, for how long, and that it is fully revocable.
// This models the AUTHORISATION itself, self-service, granted by the
// organisation's own Owner/Admin, exactly as the AVV describes. It does not
// model a staff-facing "view this org's data" console: no such cross-tenant
// surface exists anywhere in this codebase (platform_admin is scoped only to
// catalog authoring and community moderation), and the actual pseudonymised
// support gateway described in the AVV (Anlage 3 Nr. 5) is separate
// infrastructure outside this application. What this table gives the
// customer is exactly what the AVV promises them: visibility into whether
// support access is currently open, for what, until when, and a one-click
// way to revoke it.
model SupportAccessGrant {
  id               String    @id @default(uuid())
  organizationId   String
  caseReference    String // free text: what the grant is for (e.g. a support ticket reference)
  requestedByStaff String? // free text, e.g. "RIT Support" or a named staff member
  grantedByUserId  String
  status           String    @default("active") // active | revoked | expired
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedByUserId  String?
  reportSentAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedBy    User         @relation("SupportAccessGrantedBy", fields: [grantedByUserId], references: [id])
  revokedBy    User?        @relation("SupportAccessRevokedBy", fields: [revokedByUserId], references: [id])

  @@index([organizationId])
  @@index([status, expiresAt])
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           String    @default("member") // admin | member
  tokenHash      String    @unique
  status         String    @default("pending") // pending | accepted | revoked
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

model ComplianceSnapshot {
  id             String   @id @default(uuid())
  organizationId String
  capturedOn     DateTime // date (UTC midnight) the snapshot represents
  overall        Int      @default(0)
  assessments    Int      @default(0)
  openItems      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, capturedOn])
  @@index([organizationId])
}

model Comment {
  id                      String   @id @default(uuid())
  organizationId          String
  assessmentId            String
  checklistItemResponseId String?
  authorId                String?
  body                    String
  createdAt               DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment   Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  itemResponse ChecklistItemResponse? @relation(fields: [checklistItemResponseId], references: [id], onDelete: Cascade)
  author       User?                  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@index([checklistItemResponseId])
}

// ----------------------------------------------------------------------------
// Community discussion (global, cross-organization). Threads are anchored to a
// framework/requirement. visibility = global (everyone) | org (poster's org).
// This is its own GLOBAL domain and is never joined to org-scoped compliance data.
// ----------------------------------------------------------------------------

model Thread {
  id             String    @id @default(uuid())
  organizationId String // author's organisation (identity shows the company)
  // Nullable so an erasure request (GDPR Art. 17) can detach the author and
  // leave the discussion intact for everyone else, rather than cascading the
  // whole thread (and other people's replies) away.
  authorId       String?
  frameworkId    String? // anchor: the law this thread is about
  requirementCode String? // optional finer anchor (requirement code within the framework)
  visibility     String    @default("global") // global | org
  title          String
  body           String
  status         String    @default("open") // open | locked
  pinned         Boolean   @default(false)
  score          Int       @default(0)
  replyCount     Int       @default(0)
  translations   Json? // cached machine translations, e.g. { "de": { "title": "...", "body": "..." } }
  lastActivityAt DateTime  @default(now())
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  framework    Framework?   @relation(fields: [frameworkId], references: [id])
  posts        ThreadPost[]

  @@index([frameworkId])
  @@index([visibility])
  @@index([organizationId])
  @@index([lastActivityAt])
}

model ThreadPost {
  id             String    @id @default(uuid())
  threadId       String
  organizationId String
  authorId       String? // nullable for erasure — see Thread.authorId
  parentPostId   String? // one level of nesting (reply to a reply)
  body           String
  translations   Json? // cached machine translations, e.g. { "de": { "body": "..." } }
  score          Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  thread       Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       ThreadPost?  @relation("PostChildren", fields: [parentPostId], references: [id])
  children     ThreadPost[] @relation("PostChildren")

  @@index([threadId])
  @@index([parentPostId])
}

// Votes and reports reference a target by (type, id) rather than a FK, so one
// table serves both threads and posts. Cached scores live on the target rows.
model ThreadVote {
  id         String   @id @default(uuid())
  userId     String
  targetType String // thread | post
  targetId   String
  value      Int // +1 | -1
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model ThreadReport {
  id         String    @id @default(uuid())
  reporterId String
  targetType String // thread | post
  targetId   String
  reason     String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([resolvedAt])
}
