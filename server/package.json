    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.2.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.19.0",
    "qrcode": "^1.5.4",
    "resend": "^6.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "vitest": "^2.1.5"
