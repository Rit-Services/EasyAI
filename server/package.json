{
  "name": "aicompliance-server",
  "version": "1.0.0",
  "description": "API for the Germany AI Compliance platform",
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "seed": "node prisma/seed.js",
    "encrypt:backfill": "node scripts/backfillEncryption.js",
    "prisma:generate": "prisma generate",
